<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Live dictation records from the microphone. Required because Hardened
	     Runtime is on in Release; without it the mic is denied. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Nothing else. `files.user-selected.read-only` used to sit here and did
	     nothing: the app is not sandboxed (ENABLE_APP_SANDBOX = NO), so no entitlement
	     governs file access, and it read as "the sandbox is one switch away" when it
	     is not — read-only would not even cover writing the notes. Turning the sandbox
	     on means a wider file entitlement and moving the store into the container,
	     which is a decision, not a leftover. Removed 2026-08-11 (audit P3-04).

	     This file is not the whole story, and the difference is invisible from here:
	     deleting the key changed nothing in the signed product, because
	     ENABLE_USER_SELECTED_FILES = readonly in the build settings put it straight
	     back. It had to go in both places. The same mechanism supplies the microphone
	     from ENABLE_RESOURCE_ACCESS_AUDIO_INPUT = YES — so always read the result off
	     the built package (`codesign -d --entitlements -`), never off this file. -->

</dict>
</plist>
