<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Live dictation records from the microphone. Required because Hardened
	     Runtime is on in Release; without it the mic is denied. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Files the user picks in an open panel (attachments). Inert: the app is not
	     sandboxed (ENABLE_APP_SANDBOX = NO), so nothing consults this today.
	     Kept rather than removed, but do not read it as "the sandbox is one switch
	     away" — read-only would not cover writing the notes themselves, so turning
	     the sandbox on needs this entitlement widened and the store moved into the
	     container. Audit note P3-04, 2026-08-11. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
</dict>
</plist>
