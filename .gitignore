# macOS
.DS_Store

# Klucze i certyfikaty — .p12 zawiera klucz prywatny do podpisywania kodu
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile

# Xcode — user-specific state, never shared
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Build products
build/
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# Installer build material (licence text, ReadMe, installer wizard screens).
# The author's working files — not part of the code and not for a public
# repository. The pattern covers future installers of other programs too.
* - instalator/
